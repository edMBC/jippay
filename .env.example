# ---------------------------------------------------------------------------
# Jippay — variables de entorno
# Copia este archivo a `.env.local` para desarrollo local (nunca subas .env*).
# ---------------------------------------------------------------------------

# DeepSeek (extractor neuro-simbólico). Si se omite, el agente usa el
# fallback determinista (regex + heurísticas).
DEEPSEEK_API_KEY=

# Supabase Auth — proveedor de identidad verificada en el servidor.
# `SUPABASE_URL` + `SUPABASE_SERVICE_ROLE_KEY` se usan SOLO en el servidor para
# verificar la sesión (`auth.getUser`). Nunca expongas la clave de servicio al
# navegador (solo NEXT_PUBLIC_* se exponen).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# PostgreSQL (conexión directa) — ledger financiero transaccional (Regla B).
# Sin esta variable, la capa financiera opera en memoria (demo, no multi-instancia).
DATABASE_URL=

# Base PostgreSQL desechable para las pruebas de concurrencia real (solo CI/tests).
TEST_DATABASE_URL=

# Secreto para firmar las sesiones SOX (cookie HttpOnly).
SESSION_SECRET=

# Siembra de la empresa demo en desarrollo. Pon "false" para desactivarla.
ALLOW_DEMO_SEED=

# Solo para scripts/run-qa-smoke.ts (auditoría HTTP contra un servidor en vivo).
BASE_URL=http://localhost:3000
